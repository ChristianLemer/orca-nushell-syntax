# Notes, plans and specs live outside the repository, never in git.
# No trailing slash: a symlink is a file to git (see orca.yaml).
docs
meta

.superpowers
node_modules
.DS_Store

.orca

# The snapshot tool writes beside the file it reads, so the tests work on copies of the
# samples. Only the snapshots are kept.
tests/snapshots/*
!tests/snapshots/*.snap
